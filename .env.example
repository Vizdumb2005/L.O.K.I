# Optional environment for the LLM patter proxy. Never commit a real key.
# Default build uses offline templates and makes no network calls.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open
LLM_PROXY_PORT=8787
# Optional hosted voice (M5, opt-in). Unset = disabled; on-device voice only.
# VITE_ vars are public by design - the relay URL is not a secret; vendor keys live only on the relay.
VITE_HOSTED_VOICE_RELAY_URL=
VITE_HOSTED_VOICE_PROVIDER=
